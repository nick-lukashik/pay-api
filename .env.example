# Copy to .env with `pnpm env:local`. In Kubernetes: ConfigMap pay-api-config and
# SealedSecret pay-api-secrets (envFrom).
NODE_ENV=development
PORT=4400
LOG_LEVEL=info
APP_VERSION=dev
METRICS_PORT=9474
TRUST_PROXY_HOPS=0
SHUTDOWN_DELAY_MS=0

DATABASE_URL=postgres://app:app@localhost:5444/app
DATABASE_POOL_MAX=10
RABBITMQ_URL=amqp://app:app@localhost:5684

ID_JWKS_URL=http://localhost:4100/.well-known/jwks.json
TOKEN_ISSUER=http://localhost:3100
TOKEN_AUDIENCE=nick-lukashik
ID_API_URL=http://localhost:4100
ID_WEB_URL=http://localhost:3100
WALLET_API_URL=http://localhost:4300
RECONCILIATION_INTERVAL_MS=60000

# fake: no money, id-web's /payments/fake/<id> confirms. lava: needs the keys and offers below.
PAY_PROVIDER=fake
PAY_ALLOW_FAKE=false
LAVA_API_URL=https://gate.lava.top

# Secrets, never committed. ID_INTERNAL_TOKEN = INTERNAL_API_TOKEN of id-api,
# WALLET_INTERNAL_TOKEN = INTERNAL_API_TOKEN of wallet-api.
ID_INTERNAL_TOKEN=
WALLET_INTERNAL_TOKEN=
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
LAVA_OFFER_COINS_100=
LAVA_OFFER_COINS_550=
LAVA_OFFER_COINS_1200=
